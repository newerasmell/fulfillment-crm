{
  "permissions": {
    "allow": [
      "Bash(pnpm *)", "Bash(npx prisma *)", "Bash(node *)", "Bash(git status*)", "Bash(git diff*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git log*)", "Bash(git checkout *)", "Bash(git branch*)",
      "Bash(python3 tools/*)", "Bash(bash tools/*)"
    ],
    "deny": [
      "Read(./.env.production)", "Read(./.env.prod*)", "Read(//**/*.pem)", "Read(//**/id_rsa*)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * main*)", "Bash(git push * master*)",
      "Bash(git reset --hard*)", "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh", "timeout": 30 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.sh", "timeout": 900 } ] }
    ]
  }
}
