# Copy to autopilot/autopilot.env (never commit it). NO production vendor/Shopify credentials here.
# Claude auth — one of:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# GitHub (repo scope) so the runner can push the autopilot branch and open PRs
GH_TOKEN=
# Notifications (Telegram recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
# Limits
STOP_AT_PHASE=4
TOTAL_BUDGET_USD=400
TASK_BUDGET_USD=20
MODEL=opus
