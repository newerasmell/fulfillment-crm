{
  "name": "fulfillment-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tools/e2e.ts",
    "typecheck": "prisma generate >/dev/null 2>&1 && tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "check:live": "tsx tools/check-live.ts",
    "docs:refresh": "bash tools/fetch_specs.sh",
    "postinstall": "prisma generate",
    "owner:create": "tsx tools/create-owner.ts",
    "render:validate": "tsx tools/validate-render.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@prisma/engines",
      "prisma",
      "@parcel/watcher",
      "@swc/core",
      "sharp"
    ]
  }
}
