# Copy to .env for local development. NO real secrets here, ever.
# App database (non-superuser role so row-level security applies).
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5432/crm_dev
# Test helper: superuser URL used to create/drop throwaway test databases, and the app URL template
# (database name is replaced per run).
TEST_DATABASE_ADMIN_URL=postgresql://crm:crm@localhost:5432/postgres
TEST_DATABASE_URL=postgresql://crm_app:crm_app@localhost:5432/crm_test
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
# Auth.js session secret (any long random string locally).
AUTH_SECRET=
AUTH_TRUST_HOST=true
LOG_LEVEL=info
