// Fulfillment CRM domain model (docs/SPEC.md §3).
//
// Tenant integrity: every business table carries accountId and is protected by RLS (see the init
// migration). Every relation between business tables is a COMPOSITE foreign key (accountId, xId) →
// (accountId, id), so a row can never point at a parent of another account (FK checks ignore RLS).
// Optional/secondary relations use onDelete: NoAction (checked at end of statement), so deleting a parent
// that is still referenced fails, while an account-wide cascade still works. Accounts are never hard-deleted
// in production (audit log is append-only).
//
// ERD (main relations):
//
//   Account ─┬─< Membership >── User
//            ├─< Credential            (encrypted secrets; referenced by Store / FulfillmentConnection)
//            ├─< Store ─────────< StoreVariantLink >── Product ─< ProductEan
//            ├─< FulfillmentConnection ─< VendorProduct ── StockLevel
//            │                         ├─< StockMovement
//            │                         ├─< InboundShipment ─< InboundLine >── Product
//            │                         ├─< RoutingRule
//            │                         └─< OutboundRequest (outbox)
//            ├─< CountrySetting
//            ├─< Order ─┬─< OrderLine >── Product
//            │          ├─< Fulfillment ─┬─< FulfillmentEvent
//            │          │                └─< FulfillmentLine >── OrderLine
//            │          └─< Review
//            ├─< Alert, AuditLog, WebhookEvent, AiPolicy
//   ApiSpecVersion (global, not per account)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum Role {
  OWNER
  ADMIN
  OPERATOR
  WAREHOUSE
  VIEWER
}

enum ConnectionType {
  FHB_V3
  FHB_JOY
  EUSHIPMENTS
}

/// Production-only staged rollout, INTEGRATION_NOTES §6. Enforced in the outbox sender.
enum LiveMode {
  READ_ONLY
  DRY_RUN
  CANARY
  LIVE
}

/// Shopify write-back / inventory push follow the same staging (INTEGRATION_NOTES §6).
enum StoreWriteMode {
  READ_ONLY
  DRY_RUN
  LIVE
}

enum InventoryPushMode {
  DISABLED
  DRY_RUN
  LIVE
}

enum CrmOrderStatus {
  IMPORTED
  CHECKING
  NEEDS_REVIEW
  READY
  APPROVED
  QUEUED
  SUBMITTING
  SUBMIT_FAILED
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  COD_PAID
  RETURNING
  RETURN_RECEIVED
  EXCEPTION
  ON_HOLD
  BLOCKED
  CANCELLED
  UNKNOWN
  /// Shopify already reported it fulfilled when we first saw it: shipped outside the CRM, nothing to do.
  FULFILLED_EXTERNALLY
}

enum OrderSource {
  SHOPIFY
  MANUAL
}

enum PaymentMethod {
  COD
  PREPAID
}

enum StockSource {
  PUSH
  POLL
}

enum ReviewDecision {
  APPROVE
  EDIT_AND_APPROVE
  HOLD
  CANCEL
  REROUTE
}

enum OutboundStatus {
  PENDING // queued, not yet processed by the sender
  PAUSED // account or global pause active; re-evaluated once the pause is lifted
  HELD // parked by the kill switch; released only by an explicit OWNER action (then re-confirmed in CANARY)
  REFUSED // connection in READ_ONLY
  DRY_RUN_RECORDED // DRY_RUN: payload recorded, nothing sent
  AWAITING_CONFIRMATION // CANARY: needs an operator click (or daily cap reached)
  SENDING
  SENT
  FAILED // vendor rejected; definitely not created
  UNCERTAIN // outcome unknown and no read-back possible: operator task, never auto-retried
}

enum WebhookSource {
  SHOPIFY
  FHB
  EUSHIPMENTS
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AiLevel {
  L0
  L1
  L2
}

// ───────────────────────── tenancy & access ─────────────────────────

/// The tenant: one business GROUP (all its companies). Row-level security isolates groups from each other.
/// Inside a group, companies share the product catalogue and stock; who sees which company is a
/// permission (MembershipCompany), not a database wall.
model Account {
  id              String    @id @default(cuid())
  name            String
  legalDetails    Json?
  defaultCurrency String    @default("EUR")
  timezone        String    @default("Europe/Sofia")
  settings        Json      @default("{}")
  /// Kill switch: pauses the outbox for this account (INTEGRATION_NOTES §6).
  outboxPaused    Boolean   @default(false)
  /// Last kill switch (informational; held requests carry status HELD).
  killSwitchAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companies       Company[]
  memberships     Membership[]
  invitations     Invitation[]
  credentials     Credential[]
  stores          Store[]
  connections     FulfillmentConnection[]
  routingRules    RoutingRule[]
  countrySettings CountrySetting[]
  products        Product[]
  orders          Order[]
  alerts          Alert[]
  auditLogs       AuditLog[]
  webhookEvents   WebhookEvent[]
  aiPolicies      AiPolicy[]
  eushipmentsStatusMappings EushipmentsStatusMapping[]
  fulfillBatches            FulfillBatch[]
  shopifyWriteBacks         ShopifyWriteBack[]
  alertNotes                AlertNote[]
  alertNotifications        AlertNotification[]
  reviewReasonCodes         ReviewReasonCode[]
  productLines              ProductLine[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  /// TOTP secret, encrypted with the credentials vault key (never stored in clear).
  totpSecretEnc  String?
  totpEnabled    Boolean   @default(false)
  /// Last accepted TOTP time step (replay protection).
  totpLastStep   Int?
  /// Bumped to invalidate all sessions of the user.
  sessionVersion Int       @default(0)
  locale         String    @default("bg")
  disabled       Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships Membership[]
}

/// A legal entity (фирма) inside the group. Owns stores, warehouse connections and orders. Never hard-deleted:
/// archived companies keep their history (orders, shipments, audit) and disappear from the menus.
model Company {
  id           String    @id @default(cuid())
  accountId    String
  name         String
  legalDetails Json?
  archivedAt   DateTime?
  /// Product line of the company (P5-00): every company sells the goods of exactly one line. Null = not set yet.
  lineId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account     Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  line        ProductLine?            @relation(fields: [accountId, lineId], references: [accountId, id], onDelete: NoAction)
  stores      Store[]
  connections FulfillmentConnection[]
  orders      Order[]
  memberScope MembershipCompany[]
  inviteScope InvitationCompany[]

  @@unique([accountId, id])
  @@unique([accountId, name])
}

model Membership {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies MembershipCompany[]

  @@unique([accountId, id])
  @@unique([userId, accountId])
  @@index([accountId])
}

/// Company restriction of a member. No rows = the member sees every company of the group (owners always do).
model MembershipCompany {
  accountId    String
  membershipId String
  companyId    String

  membership Membership @relation(fields: [accountId, membershipId], references: [accountId, id], onDelete: Cascade)
  company    Company    @relation(fields: [accountId, companyId], references: [accountId, id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@index([accountId])
}

/// Single-use, expiring invitation to join an account. Admins never see anyone's password or 2FA key:
/// a new person sets both when opening the link; an existing user must log in and accept.
model Invitation {
  id          String    @id @default(cuid())
  accountId   String
  email       String
  role        Role
  /// Suggested display name for a new user.
  name        String?
  /// sha256 of the token; the token itself is shown once to the inviter.
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companies InvitationCompany[]

  @@unique([accountId, id])
  @@index([accountId, email])
}

/// Company restriction carried by an invitation; copied to MembershipCompany on acceptance.
model InvitationCompany {
  accountId    String
  invitationId String
  companyId    String

  invitation Invitation @relation(fields: [accountId, invitationId], references: [accountId, id], onDelete: Cascade)
  company    Company    @relation(fields: [accountId, companyId], references: [accountId, id], onDelete: Cascade)

  @@id([invitationId, companyId])
  @@index([accountId])
}

/// Login rate limiting (per email and per IP), shared by all web instances.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Encrypted secret (AES-256-GCM). Never returned to the browser after save.
model Credential {
  id          String   @id @default(cuid())
  accountId   String
  label       String
  ciphertext  String
  iv          String
  authTag     String
  keyVersion  Int      @default(1)
  /// Safe hint for the UI, e.g. "••••3f9a".
  hint        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stores      Store[]
  connections FulfillmentConnection[]

  @@unique([accountId, id])
  @@index([accountId])
}

// ───────────────────────── channels & warehouses ─────────────────────────

model Store {
  id                String            @id @default(cuid())
  accountId         String
  /// Owning company. Nullable only until the backfill migration has run everywhere.
  companyId         String?
  domain            String
  /// Short permanent code used in external ids (e.g. order id {CODE}-{number}).
  code              String
  name              String
  currency          String
  countries         String[]
  credentialId      String?
  webhookStatus     Json              @default("{}")
  syncCursors       Json              @default("{}")
  /// Shop name as Shopify reports it (filled by the connection test).
  shopName          String?
  /// Payment gateway names that mean cash on delivery in this store (case-insensitive), e.g. "Cash on Delivery (COD)".
  codGateways       String[]          @default(["Cash on Delivery (COD)", "cash_on_delivery", "Наложен платеж"])
  /// Prefix this store adds to SKUs (stripped before matching variants to master products).
  skuPrefix         String?
  /// Last connection test: {ok, at, error?, shopName?, currency?}
  connectionStatus  Json              @default("{}")
  writeBackMode     StoreWriteMode    @default(READ_ONLY)
  inventoryPushMode InventoryPushMode @default(DISABLED)
  inventoryBuffer   Int               @default(0)
  notifyCustomer    Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  account      Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company      Company?           @relation(fields: [accountId, companyId], references: [accountId, id], onDelete: NoAction)
  credential   Credential?        @relation(fields: [accountId, credentialId], references: [accountId, id], onDelete: NoAction)
  variantLinks StoreVariantLink[]
  orders       Order[]
  writeBacks   ShopifyWriteBack[]

  @@unique([accountId, id])
  @@unique([accountId, code])
  @@unique([accountId, domain])
}

model FulfillmentConnection {
  id                 String         @id @default(cuid())
  accountId          String
  /// Owning company (whose warehouse account this is). Nullable only until the backfill has run everywhere.
  companyId          String?
  type               ConnectionType
  name               String
  liveMode           LiveMode       @default(READ_ONLY)
  credentialId       String?
  /// Vendor-side ids, e.g. euShipments companyId/senderId, FHB client id.
  vendorIds          Json           @default("{}")
  warehouseIds       String[]
  /// e.g. {"prefix":"R"} — applied to product ids sent to the vendor.
  skuPrefixRule      Json           @default("{}")
  defaultSender      Json?
  /// Next FHB variable symbol (per-connection numeric sequence).
  variableSymbolNext BigInt         @default(1)
  features           String[]
  canaryDailyCap     Int            @default(10)
  enabled            Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company          Company?          @relation(fields: [accountId, companyId], references: [accountId, id], onDelete: NoAction)
  credential       Credential?       @relation(fields: [accountId, credentialId], references: [accountId, id], onDelete: NoAction)
  vendorProducts   VendorProduct[]
  stockMovements   StockMovement[]
  inbounds         InboundShipment[]
  routingRules     RoutingRule[]
  fulfillments     Fulfillment[]
  outboundRequests OutboundRequest[]
  fhbSyncStates    FhbSyncState[]
  fhbOrders        FhbOrderMirror[]
  fhbCods          FhbCodMirror[]
  fhbReturns       FhbReturnMirror[]
  fhbCarriers      FhbCarrier[]
  fhbPickupPoints  FhbPickupPoint[]
  eushipmentsSettings  EushipmentsSettings?
  eushipmentsTransfers EushipmentsTransfer[]
  eushipmentsVendorCompanies EushipmentsVendorCompany[]
  eushipmentsCouriers        EushipmentsCourier[]
  eushipmentsWarehouses      EushipmentsWarehouse[]
  eushipmentsCountries       EushipmentsCountry[]
  eushipmentsCities          EushipmentsCity[]
  eushipmentsOffices         EushipmentsOffice[]
  eushipmentsStock           EushipmentsStock[]
  eushipmentsTracking        EushipmentsTracking[]
  eushipmentsSyncs           EushipmentsSync[]
  masterCatalogueRuns        MasterCatalogueRun[]

  @@unique([accountId, id])
  @@index([accountId])
}

model RoutingRule {
  id                  String   @id @default(cuid())
  accountId           String
  name                String
  priority            Int
  enabled             Boolean  @default(true)
  /// {storeIds?, countries?, payment?, tags?, productIds?, requireStock?}
  match               Json     @default("{}")
  connectionId        String
  parcelService       String?
  courierId           String?
  serviceName         String?
  deliveryPointPolicy String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account    Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, priority])
}

model CountrySetting {
  id              String @id @default(cuid())
  accountId       String
  country         String
  currency        String
  phoneRules      Json   @default("{}")
  defaultCouriers Json   @default("{}")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, country])
}

// ───────────────────────── catalog & stock ─────────────────────────

model Product {
  id              String   @id @default(cuid())
  accountId       String
  sku             String
  name            String
  brand           String?
  /// EDT / EDP / Parfum / Elixir / Intense … — distinct products.
  type            String?
  attributes      Json     @default("{}")
  isTester        Boolean  @default(false)
  /// A tester points to its original (for "Тестерите под оригинала").
  parentProductId String?
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  hsCode          String?
  countryOfOrigin String?
  images          String[]
  archived        Boolean  @default(false)
  /// Product line of the master (P5-00). Null = not assigned to a line yet.
  lineId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  line           ProductLine?       @relation(fields: [accountId, lineId], references: [accountId, id], onDelete: NoAction)
  parent         Product?           @relation("TesterOf", fields: [accountId, parentProductId], references: [accountId, id], onDelete: NoAction)
  testers        Product[]          @relation("TesterOf")
  eans           ProductEan[]
  variantLinks   StoreVariantLink[]
  vendorProducts VendorProduct[]
  orderLines     OrderLine[]
  inboundLines   InboundLine[]

  @@unique([accountId, id])
  @@unique([accountId, sku])
  @@index([accountId, lineId])
}

/// Known EANs of a product with batch notes. Never a join key.
model ProductEan {
  id        String   @id @default(cuid())
  accountId String
  productId String
  ean       String
  note      String?
  source    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [accountId, productId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, ean])
}

model StoreVariantLink {
  id                String    @id @default(cuid())
  accountId         String
  storeId           String
  shopifyVariantGid String
  shopifyProductGid String
  sku               String?
  barcode           String?
  title             String
  productId         String?
  matchMethod       String?
  matchedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store      Store       @relation(fields: [accountId, storeId], references: [accountId, id], onDelete: Cascade)
  product    Product?    @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)
  orderLines OrderLine[]

  @@unique([accountId, id])
  @@unique([storeId, shopifyVariantGid])
  @@index([accountId, productId])
}

model VendorProduct {
  id           String    @id @default(cuid())
  accountId    String
  connectionId String
  productId    String?
  /// Vendor product id / refNumber (what we send).
  vendorId     String
  vendorCode   String?
  /// Read-only mirror of the vendor's EAN; never overwritten from our data.
  vendorEan    String?
  archived     Boolean   @default(false)
  lastSyncAt   DateTime?
  raw          Json?

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)
  product    Product?              @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)
  stockLevel StockLevel?
  movements  StockMovement[]

  @@unique([accountId, id])
  @@unique([connectionId, vendorId])
  @@index([accountId, productId])
}

model StockLevel {
  id              String      @id @default(cuid())
  accountId       String
  vendorProductId String      @unique
  physical        Int         @default(0)
  free            Int         @default(0)
  reserved        Int         @default(0)
  sellable        Int         @default(0)
  snapshotAt      DateTime
  source          StockSource

  vendorProduct VendorProduct @relation(fields: [accountId, vendorProductId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, vendorProductId])
  @@index([accountId])
}

model StockMovement {
  id              String   @id @default(cuid())
  accountId       String
  connectionId    String
  vendorProductId String?
  /// vendor movement id, or "res:<orderId>" for our reservations
  externalId      String
  kind            String
  quantity        Int
  occurredAt      DateTime
  raw             Json?

  connection    FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)
  vendorProduct VendorProduct?        @relation(fields: [accountId, vendorProductId], references: [accountId, id], onDelete: NoAction)

  @@unique([connectionId, externalId])
  @@index([accountId, occurredAt])
}

/// FHB stock receipt or euShipments booking request.
model InboundShipment {
  id           String    @id @default(cuid())
  accountId    String
  connectionId String
  /// Deterministic id we send (idempotency).
  externalRef  String
  vendorId     String?
  status       String
  tracking     String?
  expectedAt   DateTime?
  raw          Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)
  lines      InboundLine[]

  @@unique([accountId, id])
  @@unique([connectionId, externalRef])
  @@index([accountId])
}

model InboundLine {
  id          String  @id @default(cuid())
  accountId   String
  inboundId   String
  productId   String
  expectedQty Int
  receivedQty Int?
  comment     String?

  inbound InboundShipment @relation(fields: [accountId, inboundId], references: [accountId, id], onDelete: Cascade)
  product Product         @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)

  @@index([accountId])
}

// ───────────────────────── orders & shipments ─────────────────────────

model Order {
  id                       String         @id @default(cuid())
  accountId                String
  /// Selling company (the store's company, or chosen for a manual order). Shipping may come from another
  /// company's warehouse (see Fulfillment.connection.companyId) — recorded in the CRM only.
  companyId                String?
  source                   OrderSource
  storeId                  String?
  shopifyOrderGid          String?
  /// Human order number as shown in Shopify (e.g. #1234) or manual sequence.
  number                   String
  status                   CrmOrderStatus @default(IMPORTED)
  customerName             String?
  email                    String?
  phone                    String?
  shippingAddressOriginal  Json?
  shippingAddress          Json?
  billingAddress           Json?
  currency                 String
  subtotal                 Decimal        @db.Decimal(12, 2)
  total                    Decimal        @db.Decimal(12, 2)
  paymentMethod            PaymentMethod
  codAmount                Decimal?       @db.Decimal(12, 2)
  /// COD in the destination country's local currency + the rate used.
  codLocalAmount           Decimal?       @db.Decimal(12, 2)
  codLocalCurrency         String?
  codRate                  Decimal?       @db.Decimal(14, 6)
  tags                     String[]
  note                     String?
  risk                     Json?
  placedAt                 DateTime
  cancelledAt              DateTime?
  /// Shipping country (ISO-2), denormalised from the address for filters and routing.
  countryCode              String?
  shopifyFinancialStatus   String?
  shopifyFulfillmentStatus String?
  /// Shopify's updatedAt of the version we hold: an older event never overwrites newer data.
  shopifyUpdatedAt         DateTime?
  raw                      Json?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [accountId, companyId], references: [accountId, id], onDelete: NoAction)
  store        Store?        @relation(fields: [accountId, storeId], references: [accountId, id], onDelete: NoAction)
  lines        OrderLine[]
  fulfillments Fulfillment[]
  reviews      Review[]
  events       OrderEvent[]
  check        OrderCheck?
  fulfillBatchItems FulfillBatchItem[]
  shopifyWriteBacks ShopifyWriteBack[]

  @@unique([accountId, id])
  @@unique([accountId, storeId, shopifyOrderGid])
  @@index([accountId, status, placedAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  accountId      String
  orderId        String
  variantLinkId  String?
  productId      String?
  /// Shopify line item id (stable across order edits); null for manual orders.
  shopifyLineGid String?
  sku            String?
  title          String
  quantity       Int
  /// Unit price after discounts, order currency.
  unitPrice      Decimal @db.Decimal(12, 2)

  order            Order             @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)
  variantLink      StoreVariantLink? @relation(fields: [accountId, variantLinkId], references: [accountId, id], onDelete: NoAction)
  product          Product?          @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)
  fulfillmentLines FulfillmentLine[]

  @@unique([accountId, id])
  @@unique([orderId, shopifyLineGid])
  @@index([accountId, orderId])
}

/// A shipment of (part of) an order at one connection. An order can have several (split / reship).
model Fulfillment {
  id              String         @id @default(cuid())
  accountId       String
  orderId         String
  connectionId    String
  /// Deterministic id we send, e.g. {STORECODE}-{number}[-n]. Unique per connection: duplicate guard.
  externalId      String
  variableSymbol  String?
  vendorUid       String?
  vendorOrderId   String?
  carrier         String?
  deliveryPoint   Json?
  status          CrmOrderStatus
  rawStatus       String?
  trackingNumbers String[]
  trackingUrls    String[]
  labelFileKey    String?
  codStatus       String?
  returnInfo      Json?
  submittedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order            Order                 @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)
  connection       FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: NoAction)
  events           FulfillmentEvent[]
  lines            FulfillmentLine[]
  outboundRequests OutboundRequest[]
  shopifyWriteBack ShopifyWriteBack?

  @@unique([accountId, id])
  @@unique([connectionId, externalId])
  @@unique([connectionId, variableSymbol])
  @@index([accountId, status])
}

model FulfillmentEvent {
  id            String          @id @default(cuid())
  accountId     String
  fulfillmentId String
  occurredAt    DateTime
  source        String
  rawStatus     String?
  status        CrmOrderStatus?
  payload       Json?

  fulfillment Fulfillment @relation(fields: [accountId, fulfillmentId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, fulfillmentId, occurredAt])
}

/// Which order lines (and how many) a fulfillment ships — needed for split shipments and reships.
model FulfillmentLine {
  id            String @id @default(cuid())
  accountId     String
  fulfillmentId String
  orderLineId   String
  quantity      Int

  fulfillment Fulfillment @relation(fields: [accountId, fulfillmentId], references: [accountId, id], onDelete: Cascade)
  orderLine   OrderLine   @relation(fields: [accountId, orderLineId], references: [accountId, id], onDelete: NoAction)

  @@unique([fulfillmentId, orderLineId])
  @@index([accountId])
}

/// Pre-flight results + the human (or AI) decision. This is the AI training data.
model Review {
  id           String                       @id @default(cuid())
  accountId    String
  orderId      String
  findings     Json                         @default("[]")
  aiSuggestion Json?
  aiConfidence Float?
  decision     ReviewDecision?
  /// Field-level diff of operator edits: [{field, from, to}]
  diff         Json?
  reasonCode   String?
  reasonText   String?
  reviewerId   String?
  timeSpentMs  Int?
  /// 1024 dimensions (Voyage voyage-3.5 default size); decided in PROGRESS.md before P8-01.
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())
  decidedAt    DateTime?

  order Order @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

// ───────────────────────── outbox, inbound events, ops ─────────────────────────

/// Outbox: every vendor write goes through here (CLAUDE.md non-negotiables).
model OutboundRequest {
  id             String         @id @default(cuid())
  accountId      String
  connectionId   String
  operation      String
  /// Deterministic key; a second enqueue with the same key is rejected by the DB.
  idempotencyKey String
  payload        Json
  status         OutboundStatus @default(PENDING)
  /// liveMode the sender evaluated last time (audit trail).
  evaluatedMode  LiveMode?
  attempts       Int            @default(0)
  lastResponse   Json?
  lastError      String?
  /// The shipment this request is for (if any).
  fulfillmentId  String?
  /// Sender lease: a request is processed by one worker at a time.
  lockedAt       DateTime?
  nextAttemptAt  DateTime?
  confirmedById  String?
  confirmedAt    DateTime?
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  connection  FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: NoAction)
  fulfillment Fulfillment?          @relation(fields: [accountId, fulfillmentId], references: [accountId, id], onDelete: NoAction)

  @@unique([connectionId, idempotencyKey])
  @@index([accountId, status])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  /// Null until the event is attributed to an account.
  accountId   String?
  source      WebhookSource
  /// Vendor event id, or a payload hash when the vendor sends none.
  dedupeKey   String
  topic       String
  headers     Json?
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([source, dedupeKey])
  @@index([accountId, receivedAt])
}

/// Alerts and operator tasks (blocked orders, unknown statuses, UNCERTAIN sends, API changes…).
model Alert {
  id         String        @id @default(cuid())
  accountId  String
  kind       String
  isTask     Boolean       @default(false)
  severity   AlertSeverity @default(WARNING)
  status     AlertStatus   @default(OPEN)
  title      String
  body       String?
  entityType String?
  entityId   String?
  assigneeId String?
  dueAt      DateTime?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes         AlertNote[]
  notifications AlertNotification[]

  @@index([accountId, status, createdAt])
}

/// Append-only: UPDATE and DELETE are rejected by a trigger (see the init migration).
model AuditLog {
  id         String   @id @default(cuid())
  /// Null for system-level events (e.g. login of a user without an active account).
  accountId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@index([accountId, createdAt])
}

/// Vendor API spec snapshots for the change watcher (global).
model ApiSpecVersion {
  id         String   @id @default(cuid())
  vendor     String
  sourceUrl  String
  fetchedAt  DateTime @default(now())
  hash       String
  normalised Json
  diff       Json?

  @@index([vendor, fetchedAt])
}

model AiPolicy {
  id           String   @id @default(cuid())
  accountId    String
  decisionType String
  level        AiLevel  @default(L0)
  thresholds   Json     @default("{}")
  enabled      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, decisionType])
}

// ───────────────────────── wave 1 · FHB v3 read mirror (P2-02) ─────────────────────────
// Local copies of what FHB shows in its own panel (SPEC §6.7). Written only by the read sync jobs
// (src/server/fhb/sync.ts); screens read from here, never from the vendor. Products and stock use the
// existing VendorProduct / StockLevel / StockMovement tables.

/// Last run of one read resource per FHB connection (freshness on the screens, windows for the next run).
model FhbSyncState {
  id           String    @id @default(cuid())
  accountId    String
  connectionId String
  /// products | stock | movements | orders | rma | returns | cod | carriers | deliveryPoints
  resource     String
  lastRunAt    DateTime?
  lastOkAt     DateTime?
  /// Scrubbed message of the last failure (null after a good run).
  lastError    String?
  /// Rows written by the last good run.
  lastCount    Int       @default(0)
  cursor       Json      @default("{}")
  updatedAt    DateTime  @updatedAt

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, resource])
  @@index([accountId])
}

/// Every order at the FHB account (order/history, GET /order, rma/list), also ones created outside the CRM.
model FhbOrderMirror {
  id              String         @id @default(cuid())
  accountId       String
  connectionId    String
  /// FHB order id (ours: {STORECODE}-{number}).
  externalId      String
  uid             String?
  variableSymbol  String?
  /// As FHB sent it; `status` is the mapped value (UNKNOWN + alert for anything unmapped).
  rawStatus       String?
  status          CrmOrderStatus
  parcelService   String?
  deliveryPoint   String?
  /// Local currency of the destination country (as FHB stores it).
  cod             Decimal?       @db.Decimal(12, 2)
  value           Decimal?       @db.Decimal(12, 2)
  country         String?
  recipientName   String?
  trackingNumbers String[]
  vendorCreatedAt DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  returnedAt      DateTime?
  /// return | claim | write_off
  returnType      String?
  /// Seen in rma/list (came back from the carrier).
  inRma           Boolean        @default(false)
  raw             Json
  lastSyncAt      DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, externalId])
  @@index([accountId, connectionId, vendorCreatedAt])
}

/// GET /cod/list: COD per order (waiting | received | paid), amounts in local currency.
model FhbCodMirror {
  id              String    @id @default(cuid())
  accountId       String
  connectionId    String
  externalId      String
  uid             String?
  variableSymbol  String?
  parcelService   String?
  cod             Decimal?  @db.Decimal(12, 2)
  /// Raw status; unknown values are kept and alerted.
  status          String?
  receivedAt      DateTime?
  paidAt          DateTime?
  vendorCreatedAt DateTime?
  raw             Json
  lastSyncAt      DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, externalId])
  @@index([accountId, connectionId, status])
}

/// GET /return/list: "local" returns processed at an FHB depot (paid extra service; may stay empty).
model FhbReturnMirror {
  id              String    @id @default(cuid())
  accountId       String
  connectionId    String
  uid             String
  vendorId        String?
  depotId         String?
  /// basic | complex
  type            String?
  status          String?
  weight          Float?
  barcodes        String[]
  items           Json      @default("[]")
  photos          Json      @default("[]")
  vendorCreatedAt DateTime?
  raw             Json
  lastSyncAt      DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, uid])
  @@index([accountId, connectionId, vendorCreatedAt])
}

/// GET /parcel-service: carrier codes available on this FHB account (never hard-coded).
model FhbCarrier {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  code         String
  name         String?
  lastSyncAt   DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, code])
}

/// GET /delivery-point/{service}?country=: pick-up points, loaded per (service, country) on request.
model FhbPickupPoint {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  service      String
  /// The country the list was requested for ("" = none); a refresh replaces exactly that list.
  queryCountry String
  vendorId     String
  externalCode String?
  name         String?
  street       String?
  city         String?
  zip          String?
  country      String?
  lastSyncAt   DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, service, queryCountry, vendorId])
  @@index([accountId, connectionId, service])
}

// ───────────────────────── euShipments (phase 3, track wave1/eushipments) ─────────────────────────

/// Category an euShipments STATUS text maps to (INTEGRATION_NOTES §4.5; see status-map.ts).
enum EushipmentsStatusCategory {
  ACCEPTED
  PROCESSING
  IN_TRANSIT
  DELIVERED
  RETURNING
  RETURN_RECEIVED
  CANCELLED
  CANCEL_PENDING
  BLOCKED
  EXCEPTION
  UNKNOWN
}

/// euShipments status text → category, per group. Seeded from the spec list (status-map.ts); texts never seen
/// before are added as UNKNOWN (confirmed = false) and alerted until an operator maps them.
model EushipmentsStatusMapping {
  id             String                    @id @default(cuid())
  accountId      String
  /// Normalised STATUS text (look-alikes → Latin, dashes unified, lowercase): the matching key.
  statusKey      String
  /// The text as the vendor sent it (or as the spec lists it).
  statusText     String
  /// Spec status id, for reference only (orders-history returns record ids, never status ids).
  vendorStatusId Int?
  category       EushipmentsStatusCategory
  final          Boolean                   @default(false)
  /// seed | observed | operator
  source         String
  /// false = observed but not mapped by anyone yet (UNKNOWN until an operator decides).
  confirmed      Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([accountId, statusKey])
}

/// Per-connection euShipments settings that do not fit FulfillmentConnection's generic columns.
model EushipmentsSettings {
  id                    String   @id @default(cuid())
  accountId             String
  connectionId          String
  /// Alert when a shipment stays in New / Information received / … longer than this (INTEGRATION_NOTES §4.5).
  acceptedAlertHours    Int      @default(24)
  acceptedAlertWorkDays Boolean  @default(true)
  /// The sender has an Econt/Speedy cash-receipt configuration: Σ(price × qty) must equal awb.bankRepayment.
  cashReceiptCod        Boolean  @default(false)
  /// Warn before queueing an order when the get-prod-avails snapshot is older than this (INTEGRATION_NOTES §5).
  stockStaleHours       Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([accountId, connectionId])
}

/// Warehouse transfer / scrap protocol (POST /fulfilment/create-transfer). externalRef is deterministic
/// (derived from this row) and unique per connection; the vendor answers a resend with 409 + the protocol.
model EushipmentsTransfer {
  id                     String   @id @default(cuid())
  accountId              String
  connectionId           String
  externalRef            String
  sourceWarehouseId      Int
  destinationWarehouseId Int?
  /// 1 = NORMAL, 3 = SCRAP
  protocolType           Int      @default(1)
  /// [{productId, refNumber, quantity, batchNo?, batchDate?}]
  items                  Json
  comments               String?
  /// QUEUED | CREATED | FAILED
  status                 String   @default("QUEUED")
  protocolId             String?
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, externalRef])
  @@index([accountId])
}

// ───────────── euShipments read side: mirror tables (phase 3 part 2, track wave1/eushipments) ─────────────
// Everything below is a local mirror of euShipments read calls (P3-02), per connection. Products themselves are
// mirrored into VendorProduct (vendorId = REFERENCE_NUMBER, vendorCode = euShipments product ID) and stock into
// StockLevel; the tables here hold what has no generic home. Nothing here is ever sent back to the vendor.

/// GET /get-user-companies: companies (client accounts) the connection's token can see.
model EushipmentsVendorCompany {
  id              String   @id @default(cuid())
  accountId       String
  connectionId    String
  vendorCompanyId Int
  name            String
  bulstat         String?
  syncedAt        DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, vendorCompanyId])
  @@index([accountId])
}

/// GET /couriers/{companyId}: couriers activated for the connection's company.
model EushipmentsCourier {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  courierId    Int
  name         String
  toOffice     Boolean  @default(false)
  toAddress    Boolean  @default(false)
  country      String?
  currency     String?
  syncedAt     DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, courierId])
  @@index([accountId])
}

/// POST /fulfilment/warehouses: warehouses assigned to the connection's company.
model EushipmentsWarehouse {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  warehouseId  Int
  name         String
  countryId    Int?
  countryIso   String?
  countryName  String?
  syncedAt     DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, warehouseId])
  @@index([accountId])
}

/// GET /get-countries: countries covered by the couriers of the token.
model EushipmentsCountry {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  countryId    Int
  name         String
  cyrillicName String?
  isoCode      String?
  syncedAt     DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, countryId])
  @@index([accountId])
}

/// GET /get-cities/{countryId}: city nomenclature (synced on demand per country).
model EushipmentsCity {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  countryId    Int
  cityId       Int
  postalCode   String?
  nameLocal    String
  nameEn       String?
  county       String?
  countyEn     String?
  syncedAt     DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, cityId])
  @@index([accountId, connectionId, countryId])
}

/// GET /offices-by-courier/{courierId}: offices and parcel lockers (recipient.officeId = officeId).
model EushipmentsOffice {
  id           String   @id @default(cuid())
  accountId    String
  connectionId String
  officeId     Int
  courierId    Int
  name         String
  code         String?
  cityId       Int?
  cityName     String?
  address      String?
  postCode     String?
  region       String?
  isStation    Boolean  @default(false)
  codSupport   Boolean  @default(false)
  latitude     String?
  longitude    String?
  /// {weekday: [begin, end], saturday: [begin, end]}
  workHours    Json?
  syncedAt     DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, officeId])
  @@index([accountId, connectionId, courierId])
}

/// GET /fulfilment/get-prod-avails: one row per product per warehouse (a snapshot, see availDate).
/// The per-product total goes to StockLevel (source POLL).
model EushipmentsStock {
  id              String    @id @default(cuid())
  accountId       String
  connectionId    String
  refNumber       String
  warehouseName   String
  vendorProductId String?
  availQty        Int
  courierItemCode String?
  availDate       DateTime?
  syncedAt        DateTime

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, refNumber, warehouseName])
  @@index([accountId, connectionId])
}

/// Polling state of one euShipments shipment (orders-history every 15 min, COD by reference).
model EushipmentsTracking {
  id              String    @id @default(cuid())
  accountId       String
  connectionId    String
  fulfillmentId   String
  referenceNumber String
  polledAt        DateTime?
  /// Final status reached (returns are polled until received): orders-history polling stops.
  stopPolling     Boolean   @default(false)
  lastError       String?
  /// check-cod-by-order: COD in the country currency as returned, payout protocol and date.
  codAmount       String?
  codAwb          String?
  codPaidNumber   String?
  codPaidAt       DateTime?
  codCheckedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([fulfillmentId])
  @@index([accountId, connectionId, stopPolling, polledAt])
}

/// Freshness of each read-side sync per connection (shown on Складове и връзки).
model EushipmentsSync {
  id            String    @id @default(cuid())
  accountId     String
  connectionId  String
  /// connection | reference | cities | products | stock | orders | bookings | cod
  kind          String
  lastStartedAt DateTime?
  lastOkAt      DateTime?
  lastError     String?
  /// Counters of the last run, e.g. {rows, matched, unmatched}
  info          Json      @default("{}")

  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([connectionId, kind])
  @@index([accountId])
}

// ───────────────────────── wave 1: API change watcher (phase 9) ─────────────────────────

/// Last run of each watched source (a vendor spec URL, the Shopify version check, the live-check sweep).
/// Global like ApiSpecVersion: specs are the same for every account. Only systemDb() touches it.
model ApiWatchSource {
  /// Source key, e.g. FHB_V3, FHB_JOY, EUSHIPMENTS, SHOPIFY, LIVE_CHECK.
  id            String    @id
  lastCheckedAt DateTime?
  lastOkAt      DateTime?
  /// Short error code/message of the last failed run (never a secret or a response body).
  lastError     String?
  /// Consecutive failed runs; an alert is raised when it reaches the threshold.
  failures      Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────── wave 2 · core of phase 4 (pipeline, checks, routing) ─────────────────────────

/// One CRM pipeline step of an order (SPEC §6.1). Written ONLY by src/server/pipeline (transition()), in the
/// same transaction as the status change: the order timeline and the audit trail of every status move.
model OrderEvent {
  id         String          @id @default(cuid())
  accountId  String
  orderId    String
  /// Null for the first event (the status the order was created with).
  fromStatus CrmOrderStatus?
  toStatus   CrmOrderStatus
  /// Transition cause, e.g. check_result, approve, vendor, shopify_cancelled (src/server/pipeline/rules.ts).
  cause      String
  /// user | system | ai
  actorType  String
  userId     String?
  /// Which code path moved it, e.g. "shopify.import", "eushipments.history", "fhb:callback".
  source     String?
  reason     String?
  meta       Json?
  createdAt  DateTime        @default(now())

  order Order @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)

  @@index([accountId, orderId, createdAt])
}

/// Latest pre-flight result of an order (P4-01 validator engine, src/server/checks): the routing decision and
/// every finding (order-level + the chosen warehouse's validators). One row per order, replaced on each check.
/// connectionId / ruleId are snapshots (no relation): deleting a rule or connection keeps the history.
model OrderCheck {
  id           String   @id @default(cuid())
  accountId    String
  orderId      String
  connectionId String?
  ruleId       String?
  /// RoutingDecision (src/server/routing/engine.ts), incl. the human-readable explanation.
  routing      Json
  /// [{code, severity: hard|soft, source, field, message_bg, message_en, suggestedFix?}]
  findings     Json     @default("[]")
  hardCount    Int      @default(0)
  softCount    Int      @default(0)
  /// Normalised values the senders will use (e.g. {phone: "+359…"}), shown next to the original.
  normalised   Json     @default("{}")
  checkedById  String?
  checkedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order Order @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, orderId])
  @@index([accountId, checkedAt])
}

// ───────────────────────── wave 2 · review track (P4-04 / P4-05) ─────────────────────────

/// Configurable reason codes for review decisions (SPEC §7.1: "a reason code from a fixed list"). An account
/// without rows uses the built-in defaults (src/server/review/reasons.ts); the first change by an admin stores
/// them. Codes are never deleted (old Review rows keep pointing at them), only deactivated.
model ReviewReasonCode {
  id        String   @id @default(cuid())
  accountId String
  /// Stable machine code stored on Review.reasonCode, e.g. "address_fixed".
  code      String
  labelBg   String
  labelEn   String
  /// Decisions this code is offered for: approve | hold | block.
  decisions String[]
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
  @@index([accountId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
// Wave 2 · track "fulfill" (P4-06 Fulfill, P4-07 Shopify write-back, P4-08 alerts/tasks)
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

/// One Fulfill action (a single order or a bulk selection). Every order gets a visible result row, so nothing
/// is partial-silent (SPEC §6.1); the batch page can be reopened and resumed.
model FulfillBatch {
  id          String    @id @default(cuid())
  accountId   String
  createdById String
  total       Int
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  account Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items   FulfillBatchItem[]

  @@unique([accountId, id])
  @@index([accountId, createdAt])
}

/// Result of one order in a FulfillBatch. status: PENDING | RUNNING | QUEUED | BLOCKED | NEEDS_ACK | SKIPPED | FAILED.
model FulfillBatchItem {
  id           String    @id @default(cuid())
  accountId    String
  batchId      String
  orderId      String
  position     Int
  status       String    @default("PENDING")
  /// Machine-readable reason (e.g. not_approved, check_stale, fhb_already_submitted).
  code         String?
  /// Findings that blocked it or need acknowledging (validator engine shape).
  findings     Json?
  connectionId String?
  liveMode     LiveMode?
  /// The outbox request created (or re-armed) for this order.
  requestId    String?
  startedAt    DateTime?
  finishedAt   DateTime?

  batch FulfillBatch @relation(fields: [accountId, batchId], references: [accountId, id], onDelete: Cascade)
  order Order        @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([batchId, orderId])
  @@index([accountId, orderId])
}

/// Shopify fulfillment write-back for one shipment (P4-07): the store-side outbox. One row per shipment (never
/// two Shopify fulfillments for one shipment); the sender gates on Store.writeBackMode at send time (READ_ONLY:
/// nothing, DRY_RUN: the exact mutation is recorded, LIVE: sent) and reads the order's fulfillments back by
/// tracking number before every send and retry.
model ShopifyWriteBack {
  id                    String          @id @default(cuid())
  accountId             String
  storeId               String
  orderId               String
  fulfillmentId         String
  status                OutboundStatus  @default(PENDING)
  /// writeBackMode the sender evaluated last time.
  evaluatedMode         StoreWriteMode?
  trackingNumber        String
  /// {mutation, variables}: what DRY_RUN would send / what LIVE sent.
  request               Json?
  attempts              Int             @default(0)
  lastResponse          Json?
  lastError             String?
  shopifyFulfillmentGid String?
  lockedAt              DateTime?
  nextAttemptAt         DateTime?
  sentAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store       Store       @relation(fields: [accountId, storeId], references: [accountId, id], onDelete: NoAction)
  order       Order       @relation(fields: [accountId, orderId], references: [accountId, id], onDelete: Cascade)
  fulfillment Fulfillment @relation(fields: [accountId, fulfillmentId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@unique([accountId, fulfillmentId])
  @@index([accountId, orderId])
  @@index([status, nextAttemptAt])
}

/// Alert/task history (P4-08): who assigned, resolved (with the note) or reopened it. Alert itself is unchanged.
model AlertNote {
  id        String   @id @default(cuid())
  accountId String
  alertId   String
  userId    String?
  /// assign | resolve | reopen | note | auto_resolve
  action    String
  note      String?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([accountId, alertId, createdAt])
}

/// One notification per alert and channel (email, telegram): the unique key makes sending idempotent.
model AlertNotification {
  id        String   @id @default(cuid())
  accountId String
  alertId   String
  channel   String
  /// SENDING | SENT | FAILED
  status    String   @default("SENDING")
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, channel])
  @@index([accountId, createdAt])
}

// ───────────────────────── wave 3 core: product lines + master catalogue (P5-00) ─────────────────────────

/// A product line of the group (e.g. cosmetics, textiles). Every company belongs to exactly one line; the companies
/// of a line sell identical goods, so master products, matching and stock fallback stay inside the line.
model ProductLine {
  id         String    @id @default(cuid())
  accountId  String
  name       String
  /// Colour token (src/server/lines/colors.ts), never a status or warehouse colour.
  color      String    @default("rose")
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account        Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companies      Company[]
  products       Product[]
  catalogueRuns  MasterCatalogueRun[]
  mappingImports ProductMappingImport[]
  dismissals     ProductMatchDismissal[]

  @@unique([accountId, id])
  @@unique([accountId, name])
}

/// Background run of "create master products from warehouse X's catalogue" (worker job, small batches, resumable).
model MasterCatalogueRun {
  id              String    @id @default(cuid())
  accountId       String
  lineId          String
  connectionId    String
  /// QUEUED | RUNNING | DONE | FAILED
  status          String    @default("QUEUED")
  /// masters | autolink | done
  phase           String    @default("masters")
  total           Int       @default(0)
  processed       Int       @default(0)
  created         Int       @default(0)
  linked          Int       @default(0)
  adopted         Int       @default(0)
  alreadyLinked   Int       @default(0)
  conflicts       Int       @default(0)
  autoLinked      Int       @default(0)
  /// A few SKUs that could not be used (another line already has them), for the operator.
  conflictSamples Json      @default("[]")
  /// Last VendorProduct id processed (the run resumes after it).
  cursor          String?
  error           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  line       ProductLine           @relation(fields: [accountId, lineId], references: [accountId, id], onDelete: Cascade)
  connection FulfillmentConnection @relation(fields: [accountId, connectionId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@index([accountId, lineId, createdAt])
}

/// "Друго": an operator rejected a match suggestion (item = VendorProduct or StoreVariantLink) — not shown again.
model ProductMatchDismissal {
  id          String   @id @default(cuid())
  accountId   String
  lineId      String
  /// vendor | variant
  kind        String
  itemId      String
  productId   String
  createdById String?
  createdAt   DateTime @default(now())

  line ProductLine @relation(fields: [accountId, lineId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, kind, itemId, productId])
  @@index([accountId, lineId])
}

/// An uploaded mapping file (Excel/CSV) of one line: validated plan first (PREVIEW), applied by a person (APPLIED).
model ProductMappingImport {
  id          String    @id @default(cuid())
  accountId   String
  lineId      String
  fileName    String
  /// PREVIEW | INVALID | APPLYING | APPLIED | FAILED
  status      String    @default("PREVIEW")
  plan        Json      @default("{}")
  errors      Json      @default("[]")
  createdById String?
  createdAt   DateTime  @default(now())
  appliedAt   DateTime?

  line ProductLine @relation(fields: [accountId, lineId], references: [accountId, id], onDelete: Cascade)

  @@unique([accountId, id])
  @@index([accountId, lineId, createdAt])
}
