   "DeliveryPoint": {
    "type": "object",
    "description": "Carrier pick-up point. Field types map directly to the `delivery_point` table; `latitude`/`longitude` are modeled as numbers (inferred — the table predates the in-repo migrations, so column types are not verified against a schema).",
