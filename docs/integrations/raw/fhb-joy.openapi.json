{
 "openapi": "3.0.0",
 "info": {
  "title": "Joy API",
  "version": "1.0",
  "description": "API for printing shipment labels.\n\nConverted from the original API Blueprint documentation (https://joylabel.docs.apiary.io)\nand consolidated against the live implementation.\n\n## Authentication\n\nEvery client has an `appId` and a `secret` (generated in the ZOE system,\nhttps://zoe2.fhb.sk/api). Use them with `POST /login` to obtain an access token.\nThe token must be **base64-encoded** and sent on every other request in the\n`X-Authentication-Simple` header. Tokens expire after 6 hours — re-login when they do.\n\n## Resource identifiers\n\nThe routing mask is `api/joy/<resource>` with no id path segment, so the `id`\n(and `order`, `parcelService`, `ids`) parameters are passed differently depending on the verb:\n\n- **Create (POST)** — pass `id` (and `order` for packing-list-item) in the **JSON body**.\n  Sending `?id=` on a create request yields `405 Method Not Allowed`.\n- **Read / Update / Delete (GET / PUT / DELETE)** — pass `id` (or `parcelService`, `ids`)\n  as a **query-string** parameter. Omitting it yields `405 Method Not Allowed`.\n\n## Errors\n\nError responses use the envelope `{ \"status\": \"error\", \"message\": <string>, \"id\": <field> }`,\nwhere `message` describes the failure and `id` (when present) names the offending field.\nCommon codes: `400` validation, `401` authentication, `404` not found, `405` wrong verb /\nmisplaced id, `409` state conflict.",
  "contact": {
   "name": "FHB",
   "url": "https://www.fhb.sk"
  }
 },
 "servers": [
  {
   "url": "https://system.fhb.sk/api/joy"
  }
 ],
 "security": [
  {
   "AuthSimple": []
  }
 ],
 "tags": [
  {
   "name": "Login",
   "description": "Obtain an access token. Every client has an `appId` and `secret` (generated in the ZOE system, https://zoe2.fhb.sk/api)."
  },
  {
   "name": "Shipments",
   "description": "Create and print shipment labels (synchronous), reprint existing labels, reject shipments and read shipment details with tracking."
  },
  {
   "name": "Labels",
   "description": "Print labels for existing orders, individually or in bulk (up to 100)."
  },
  {
   "name": "Packages",
   "description": "Asynchronous order flow — create/update/read/delete packages; labels are fetched separately via the Labels endpoint."
  },
  {
   "name": "Packing list",
   "description": "Create, read and delete packing lists."
  },
  {
   "name": "Packing list item",
   "description": "Add or remove orders within a packing list."
  },
  {
   "name": "Delivery points",
   "description": "List carrier pick-up points."
  },
  {
   "name": "Anonymization",
   "description": "Internal / GDPR operation to irreversibly anonymize a closed order's personal data."
  }
 ],
 "paths": {
  "/login": {
   "post": {
    "tags": [
     "Login"
    ],
    "summary": "Obtain an access token",
    "operationId": "login",
    "description": "Issues a temporary access token (valid 6 hours) for the given `appId`/`secret`.",
    "security": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Credentials"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Authenticated. Returns the access token and its expiration.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthToken"
        }
       }
      }
     },
     "401": {
      "description": "Missing or invalid `appId` / `secret`.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        },
        "example": {
         "status": "error",
         "message": "AppId or secret not valid"
        }
       }
      }
     }
    }
   }
  },
  "/shipments": {
   "post": {
    "tags": [
     "Shipments"
    ],
    "summary": "Create and print a shipment label",
    "operationId": "createShipment",
    "description": "Creates a shipment and returns the carrier tracking codes together with the base64 PDF label. The `id` is supplied in the body.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ShipmentRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Label created.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ShipmentLabel"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Referenced product not found (`Product with id X not found, please create it via POST /products`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "A shipment with this `id` already exists — use the update flow instead (`Resource already exists, use PUT method`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "get": {
    "tags": [
     "Shipments"
    ],
    "summary": "Print an existing label",
    "operationId": "printShipmentLabel",
    "description": "Reprints the label of an existing shipment. A label cannot be printed more than 5 days after creation.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     },
     {
      "name": "labelOrientation",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "L",
        "P"
       ]
      },
      "description": "Preferred label orientation — `P` (portrait) or `L` (landscape). Defaults to the carrier setting."
     }
    ],
    "responses": {
     "200": {
      "description": "Returns the tracking codes and the base64 PDF label.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ShipmentLabel"
        }
       }
      }
     },
     "400": {
      "description": "Invalid label orientation, or the order is older than 5 days, or the printing service is unavailable.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Shipment not found (`Package not found.`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "delete": {
    "tags": [
     "Shipments"
    ],
    "summary": "Reject a shipment",
    "operationId": "rejectShipment",
    "description": "Soft-rejects a shipment. Only shipments in the `printed` state can be rejected.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     }
    ],
    "responses": {
     "204": {
      "description": "Shipment rejected (empty body)."
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Shipment not found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Shipment is not in the `printed` state (`Order has not Printed status`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/shipment": {
   "get": {
    "tags": [
     "Shipments"
    ],
    "summary": "Get shipment information",
    "operationId": "getShipment",
    "description": "Returns shipment details together with tracking numbers, tracking links, order items and tracking events.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     }
    ],
    "responses": {
     "200": {
      "description": "Shipment detail.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ShipmentDetail"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Shipment not found (`Shipment not found.`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/labels": {
   "get": {
    "tags": [
     "Labels"
    ],
    "summary": "Print labels (bulk or single)",
    "operationId": "getLabels",
    "description": "Returns a base64-encoded A6 PDF containing the requested labels.\n\nProvide **either** `ids` (comma-separated, up to 100 order codes) for a combined\nmulti-label PDF, **or** `id` for a single order's label.",
    "parameters": [
     {
      "name": "ids",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "Comma-separated list of order identification codes (max 100). Used for the bulk variant.",
      "example": "23012345,23012346"
     },
     {
      "name": "id",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "Single order identification code. Used for the single-label variant."
     }
    ],
    "responses": {
     "200": {
      "description": "Base64-encoded PDF of the requested label(s).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Labels"
        }
       }
      }
     },
     "400": {
      "description": "`ids` missing for the bulk variant, or more than 100 ids supplied (`Maximum number of labels is 100.`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Order not found (single-label variant, `Not found.`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/packages": {
   "post": {
    "tags": [
     "Packages"
    ],
    "summary": "Create a package (asynchronous flow)",
    "operationId": "createPackage",
    "description": "Creates an order/package without immediately printing a label (the label is fetched later\nvia `GET /labels`). Returns a link to the created resource. The `id` is supplied in the body.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PackageRequest"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Package created.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourceLink"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Referenced product not found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "A package with this `id` already exists (`Resource already exists, use PUT method`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "put": {
    "tags": [
     "Packages"
    ],
    "summary": "Update a package",
    "operationId": "updatePackage",
    "description": "Updates an existing package. Only packages in the `imported` (pending) state can be updated. The `id` is taken from the query parameter.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PackageBase"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Package updated.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourceLink"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Package not found (`Package not found. Create it via POST /packages`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Package is not in the pending state (`Package has not Pending status`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "get": {
    "tags": [
     "Packages"
    ],
    "summary": "Get package information",
    "operationId": "getPackage",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     }
    ],
    "responses": {
     "200": {
      "description": "Package detail.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PackageDetail"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Package not found (`Package not found.`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "delete": {
    "tags": [
     "Packages"
    ],
    "summary": "Delete a package",
    "operationId": "deletePackage",
    "description": "Deletes a package. Only packages in the `imported` (pending) state can be deleted.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Unique order identification code."
     }
    ],
    "responses": {
     "204": {
      "description": "Package deleted (empty body)."
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Package not found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Package is not in the pending state (`Order has not Pending status`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/packing-list": {
   "post": {
    "tags": [
     "Packing list"
    ],
    "summary": "Create a packing list",
    "operationId": "createPackingList",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PackingListRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Packing list created.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PackingList"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   },
   "get": {
    "tags": [
     "Packing list"
    ],
    "summary": "Get packing list detail",
    "operationId": "getPackingList",
    "description": "Returns a packing list and its base64 label. Optionally accepts `label_orientation` (`L`/`P`)\nin the JSON body to rotate the label. Note: an invalid `label_orientation` here is not handled\nas a clean `400` (unlike on create) and may surface as a server error.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Your internal packing list code (`external_code`)."
     }
    ],
    "responses": {
     "200": {
      "description": "Packing list detail.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PackingList"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Packing list not found (`Packing list not found`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "delete": {
    "tags": [
     "Packing list"
    ],
    "summary": "Delete a packing list",
    "operationId": "deletePackingList",
    "description": "Deletes a packing list. Only lists in the `created` state can be deleted.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Your internal packing list code (`external_code`)."
     }
    ],
    "responses": {
     "200": {
      "description": "Packing list deleted.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOk"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Packing list not found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Packing list cannot be modified in its current state (`Packing list can not be modified`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/packing-list-item": {
   "post": {
    "tags": [
     "Packing list item"
    ],
    "summary": "Add an order to a packing list",
    "operationId": "addPackingListItem",
    "description": "Adds an order to a packing list. Both `id` and `order` are supplied in the body.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Your internal packing list code (`external_code`)."
         },
         "order": {
          "type": "string",
          "description": "Order identification code (`api_id`)."
         }
        },
        "required": [
         "id",
         "order"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Item added.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOk"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Packing list or order not found (`Packing list not found` / `Order not found`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "The order is already in a packing list.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "delete": {
    "tags": [
     "Packing list item"
    ],
    "summary": "Remove an order from a packing list",
    "operationId": "deletePackingListItem",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Order identification code (`api_id`)."
     }
    ],
    "responses": {
     "200": {
      "description": "Item removed.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOk"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Packing list item not found (`Packing list item not found`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Parent packing list cannot be modified in its current state.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/delivery-point": {
   "get": {
    "tags": [
     "Delivery points"
    ],
    "summary": "List available delivery points",
    "operationId": "getDeliveryPoints",
    "description": "Returns the active carrier pick-up points for the given parcel service.",
    "parameters": [
     {
      "name": "parcelService",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Parcel service code (e.g. `dhl_parcel`, `pplcz`, `packeta`)."
     }
    ],
    "responses": {
     "200": {
      "description": "List of delivery points (empty array when none match).",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/DeliveryPoint"
         }
        }
       }
      }
     },
     "400": {
      "description": "Missing `parcelService` (`Missing field parcelService`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/anonymization": {
   "put": {
    "tags": [
     "Anonymization"
    ],
    "summary": "Anonymize an order (internal / GDPR)",
    "operationId": "anonymizeOrder",
    "description": "**Internal / GDPR operation.** Irreversibly anonymizes the personal data of a *closed*\norder. Intended for data-protection purposes rather than routine integration; use with care.",
    "parameters": [
     {
      "name": "id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Order identification code (`api_id`)."
     }
    ],
    "responses": {
     "200": {
      "description": "Order anonymized.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResourceLink"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "description": "Order not found (`Package not found. Create it via POST /packages`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Order is not closed (`Package is not closed`).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "AuthSimple": {
    "type": "apiKey",
    "in": "header",
    "name": "X-Authentication-Simple",
    "description": "Base64-encoded access token. Obtain a token via `POST /login`, then send it on every request as `X-Authentication-Simple: base64(token)`. Tokens expire after 6 hours — re-login when they do."
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "Missing or invalid authentication token.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "status": "error",
       "message": "Token expired. Login via POST /login"
      }
     }
    }
   },
   "BadRequest": {
    "description": "Validation error. `message` describes the problem and `id` names the offending field.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "status": "error",
       "message": "Missing field: name",
       "id": "name"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string",
      "example": "error"
     },
     "message": {
      "type": "string",
      "description": "Human-readable error description."
     },
     "id": {
      "type": "string",
      "description": "Name of the offending field (present on validation errors)."
     }
    },
    "required": [
     "status"
    ]
   },
   "StatusOk": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string",
      "example": "ok"
     }
    },
    "required": [
     "status"
    ]
   },
   "ResourceLink": {
    "type": "object",
    "description": "HAL response containing only a self link to the affected resource.",
    "properties": {
     "_links": {
      "type": "object",
      "properties": {
       "self": {
        "type": "object",
        "properties": {
         "href": {
          "type": "string",
          "description": "URL of the resource.",
          "example": "/api/joy/packages?id=1003201"
         }
        }
       }
      }
     }
    }
   },
   "Credentials": {
    "type": "object",
    "properties": {
     "appId": {
      "type": "string",
      "description": "Application ID (32 characters).",
      "example": "1234"
     },
     "secret": {
      "type": "string",
      "description": "Application secret (40 characters).",
      "example": "1234"
     }
    },
    "required": [
     "appId",
     "secret"
    ]
   },
   "AuthToken": {
    "type": "object",
    "properties": {
     "token": {
      "type": "string",
      "description": "Access token (max 80 characters).",
      "example": "A98ophrkh67"
     },
     "expiration": {
      "type": "string",
      "description": "Date and time when the access token expires (6 hours after issue), formatted `Y-m-d H:i:s O`.",
      "example": "2014-07-08 15:00:00 +0100"
     }
    },
    "required": [
     "token",
     "expiration"
    ]
   },
   "NotifyLink": {
    "type": "object",
    "description": "Webhook URLs called on shipment status changes.",
    "properties": {
     "confirmed": {
      "type": "string",
      "format": "uri",
      "description": "Called when the package is confirmed.",
      "maxLength": 255,
      "example": "http://example.com/order/1003201/confirmed"
     },
     "sent": {
      "type": "string",
      "format": "uri",
      "description": "Called when the package is sent.",
      "maxLength": 255,
      "example": "http://example.com/order/1003201/sent"
     },
     "delivered": {
      "type": "string",
      "format": "uri",
      "description": "Called when the package is delivered.",
      "maxLength": 255,
      "example": "http://example.com/order/1003201/delivered"
     },
     "returned": {
      "type": "string",
      "format": "uri",
      "description": "Called when the package is returned.",
      "maxLength": 255,
      "example": "http://example.com/order/1003201/returned"
     }
    }
   },
   "NotifyEmbedded": {
    "type": "object",
    "properties": {
     "notifyLinks": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/NotifyLink"
      }
     }
    }
   },
   "ShipmentRequest": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "description": "Unique order identification code.",
      "example": "1003201"
     },
     "parcelService": {
      "type": "string",
      "description": "Preferred parcel service (must be a service enabled for Joy).",
      "example": "pplcz"
     },
     "name": {
      "type": "string",
      "description": "Recipient name (min 3 characters).",
      "example": "Oskar Šnajdr"
     },
     "street": {
      "type": "string",
      "description": "Recipient street (min 3 characters).",
      "example": "Hlavná 23"
     },
     "city": {
      "type": "string",
      "description": "Recipient city (min 2 characters).",
      "example": "Horní Jasenka"
     },
     "province": {
      "type": "string",
      "nullable": true,
      "description": "Recipient province/region (optional)."
     },
     "zip": {
      "type": "string",
      "description": "Recipient ZIP code (3–12 characters).",
      "example": "75501"
     },
     "country": {
      "type": "string",
      "description": "Recipient country code (ISO 3166-1 alpha-2; must be a known country).",
      "example": "cz"
     },
     "email": {
      "type": "string",
      "format": "email",
      "description": "Recipient email.",
      "example": "example@example.com",
      "maxLength": 50
     },
     "phone": {
      "type": "string",
      "description": "Recipient phone in international format (6-20 characters).",
      "minLength": 6,
      "maxLength": 20,
      "example": "+421901000000"
     },
     "variableSymbol": {
      "type": "string",
      "description": "Variable symbol. For `posta_expres` it must be numeric and at most 10 characters.",
      "example": "12345"
     },
     "cod": {
      "type": "number",
      "description": "Cash on delivery (default 0). WARNING: must always be in the delivery country's local currency.",
      "example": 250
     },
     "sender": {
      "type": "string",
      "description": "Custom sender reference. Must be one of the customer''s configured sender codes. Contact support to use multiple sender references.",
      "example": "CUSTOMER_SENDER_CODE_1"
     },
     "senderName": {
      "type": "string",
      "description": "Custom sender name."
     },
     "note": {
      "type": "string",
      "description": "Order note (used by the fulfilment centre — not sent to the recipient).",
      "example": "Note"
     },
     "numberOfPackages": {
      "type": "integer",
      "description": "Number of packages.",
      "example": 1
     },
     "weight": {
      "type": "array",
      "description": "Weight of each package. If supplied, its length must equal `numberOfPackages`.",
      "items": {
       "type": "number"
      },
      "example": [
       1.45
      ]
     },
     "deliveryPoint": {
      "type": "string",
      "description": "Delivery point code. Required when the parcel service delivers only to pick-up points.",
      "example": "12451"
     },
     "labelOrientation": {
      "type": "string",
      "enum": [
       "L",
       "P"
      ],
      "description": "Preferred label orientation — `P` (portrait) or `L` (landscape). Defaults to the carrier setting.",
      "example": "P"
     },
     "_embedded": {
      "$ref": "#/components/schemas/NotifyEmbedded"
     },
     "invoiceDetail": {
      "allOf": [
       {
        "$ref": "#/components/schemas/InvoiceDetail"
       }
      ],
      "description": "Customs declaration data (\"colné údaje\"). Must be filled for all non-EU destinations and must match the attached invoice. Mirrors the v3 API `invoice_detail`, except products do not carry a product `code`."
     }
    },
    "required": [
     "id",
     "parcelService",
     "name",
     "street",
     "city",
     "zip",
     "country",
     "email",
     "phone",
     "variableSymbol",
     "numberOfPackages"
    ]
   },
   "InvoiceDetail": {
